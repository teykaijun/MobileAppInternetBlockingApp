    <string name="vpn_permission_denied">Blocking needs the VPN permission to work.</string>
    <string name="vpn_not_supported">This device doesn\'t allow VPN apps.</string>
    <string name="vpn_settings_unavailable">VPN settings aren\'t available on this device.</string>

    <!-- Notification -->
    <string name="notification_channel_name">Blocking status</string>
    <plurals name="notification_title">
        <item quantity="one">Blocking internet for %d app</item>
        <item quantity="other">Blocking internet for %d apps</item>
    </plurals>
